{
  "name": "evolve-eval-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "évolvé evaluation dashboard (R-EVAL-1 presentation, Ledger theme). SIMULATED environment, synthetic data only. Numbers come from services/eval/out/evidence.json via scripts/sync_evidence.py.",
  "scripts": {
    "sync": "python scripts/sync_evidence.py",
    "dev": "next dev --port 3002",
    "prebuild": "python scripts/sync_evidence.py",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@evolve/ui": "*",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
