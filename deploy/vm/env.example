# évolvé VM deployment settings. Copy to deploy/vm/.env and fill in. NEVER commit a real key.
# (Named env.example, not .env.example: dot-env files are blocked for the build agents.)
# deploy/.gitignore ignores .env files; the Docker build contexts exclude them too.
DEPLOY_TARGET=vm

# Base domain you control. DNS A/AAAA records for app., counselor., eval. and api.<APP_DOMAIN> must point at the VM.
APP_DOMAIN=example.org
# Email for Let's Encrypt registration (Caddy).
ACME_EMAIL=you@example.org

# Public URLs (derived from APP_DOMAIN; listed so the deploy script can check them).
CITIZEN_URL=https://app.example.org
COUNSELOR_URL=https://counselor.example.org
EVAL_URL=https://eval.example.org
API_URL=https://api.example.org

# Backend CORS allow-list: the three app origins, comma-separated, no trailing slash.
CORS_ORIGINS=https://app.example.org,https://counselor.example.org,https://eval.example.org

# Counselor-side AI draft (DECISIONS #62). Leave empty to use the offline stub. Paste your own key only into .env.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
