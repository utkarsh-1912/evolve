# évolvé Vercel (3 apps) + Render (backend) settings. Copy to deploy/vercel-render/.env and fill in AFTER you
# have created the services (the URLs come from the Render and Vercel dashboards). NEVER commit a real key.
# These values are pasted into the dashboards; the deploy script only checks them and prints the steps.
DEPLOY_TARGET=vercel-render

# Render web service URL (Dashboard → service → URL), no trailing slash.
API_URL=https://evolve-api.onrender.com
# Vercel production URLs of the three projects.
CITIZEN_URL=https://evolve-citizen.vercel.app
COUNSELOR_URL=https://evolve-counselor.vercel.app
EVAL_URL=https://evolve-eval.vercel.app

# Set on Render: the three Vercel origins, comma-separated, no trailing slash.
CORS_ORIGINS=https://evolve-citizen.vercel.app,https://evolve-counselor.vercel.app,https://evolve-eval.vercel.app

# Set on Render only (secret). Empty → offline stub provider.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
